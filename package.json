{
  "name": "proxy-config-converter",
  "version": "1.0.0",
  "description": "一个支持 Cloudflare Workers 和 Vercel 的代理配置转换工具，支持 Mihomo、Singbox 和 V2Ray 格式",
  "main": "vercel.js",
  "type": "module",
  "scripts": {
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "analyze": "node esbuild.js --analyze",
    "dev": "npm run cf:dev",
    "cf:dev": "wrangler dev --local",
    "cf:deploy": "npm run build && wrangler deploy",
    "cf:login": "wrangler login",
    "cf:logout": "wrangler logout",
    "cf:secret": "wrangler secret",
    "vercel:dev": "vercel dev",
    "vercel:deploy": "npm run build && vercel deploy --prod",
    "vercel:login": "vercel login",
    "vercel:logout": "vercel logout"
  },
  "keywords": [
    "proxy",
    "config",
    "converter",
    "mihomo",
    "clash",
    "singbox",
    "v2ray",
    "cloudflare-workers",
    "vercel"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "esbuild": "^0.27.3",
    "wrangler": "^3.80.0",
    "vercel": "^37.0.0",
    "yaml": "^2.8.2"
  }
}
