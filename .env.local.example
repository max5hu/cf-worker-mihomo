# 本地开发环境变量示例
# 复制此文件为 .env.local 并填入实际值

# 背景图片地址
IMG=https://t.alcy.cc/ycy

# 订阅转换后端地址
SUB=https://sub-start-nodejs.pages.dev

# Mihomo 顶层配置模板地址
MIHOMOTOP=https://raw.githubusercontent.com/Kwisma/cf-worker-mihomo/main/template/Mihomo_default.yaml

# Singbox 1.11.x 顶层配置模板地址
SINGBOX_1_11=https://raw.githubusercontent.com/Kwisma/cf-worker-mihomo/main/template/singbox_default.yaml

# Singbox 1.12.x 顶层配置模板地址
SINGBOX_1_12=https://raw.githubusercontent.com/Kwisma/cf-worker-mihomo/main/template/singbox_default.yaml

# Singbox 1.12.x alpha 顶层配置模板地址
SINGBOX_1_12_ALPHA=https://raw.githubusercontent.com/Kwisma/cf-worker-mihomo/main/template/singbox_default.yaml

# Singbox 1.13.x 顶层配置模板地址
SINGBOX_1_13=https://raw.githubusercontent.com/Kwisma/cf-worker-mihomo/main/template/singbox_default.yaml

# 备案文字
BEIAN=ICP备案号：xxxxx

# 备案链接
BEIANURL=https://beian.miit.gov.cn

# 自定义 Mihomo 规则模板地址（可选）
# MIHOMO=https://example.com/custom-mihomo.yaml

# 自定义 Singbox 规则模板地址（可选）
# SINGBOX=https://example.com/custom-singbox.yaml
